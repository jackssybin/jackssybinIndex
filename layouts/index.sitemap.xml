{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $skipPrefixes := slice
      "/tags/"
      "/nav/"
      "/topics/"
      "/archives/"
      "/page/"
      "/generated/"
      "/ai-nav/"
      "/articles/2026/06/05/imgs-cognitive-process/"
  }}
  {{- /* $skipExact 只放「已经带 noindex、不需要被收录」的页面。
       判断口径必须与 layouts/_default/baseof.html 的 noindex 列表一致：
       索引里有的页面要进 sitemap，noindex 的页面要出 sitemap，
       两边不一致会让爬虫收到矛盾信号。

       2026-09-18 调整：移出 /archives.html /about.html /links.html /
       /my-github-repos/ —— 这四个页面是正常内容页、没有 noindex，
       此前却被排除在 sitemap 之外，属于漏报。
  */}}
  {{- $skipExact := slice
      "/tags.html"
      "/nav.html"
      "/topics.html"
      "/search.html"
      "/news.html"
      "/weekly.html"
      "/articles/"
      "/tutorials/"
  }}
  {{- range .Site.Pages }}
    {{- $rel := .RelPermalink }}
    {{- $skip := false }}
    {{- if not .Permalink }}{{ $skip = true }}{{ end }}
    {{- if in $skipExact $rel }}{{ $skip = true }}{{ end }}
    {{- range $skipPrefixes }}
      {{- if hasPrefix $rel . }}{{ $skip = true }}{{ end }}
    {{- end }}
    {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $last := .Lastmod }}
    {{- if $last }}
    <lastmod>{{ $last.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>{{ if .IsPage }}0.8{{ else }}0.5{{ end }}</priority>
  </url>
    {{- end }}
  {{- end }}
</urlset>