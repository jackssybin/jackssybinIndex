{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $skipPrefixes := slice
      "/tags/"
      "/nav/"
      "/topics/"
      "/archives/"
      "/page/"
      "/generated/"
      "/articles/2026/06/05/imgs-cognitive-process/"
  }}
  {{- $skipExact := slice
      "/tags.html"
      "/nav.html"
      "/topics.html"
      "/archives.html"
      "/search.html"
      "/news.html"
      "/weekly.html"
      "/articles/"
      "/tutorials/"
  }}
  {{- range .Site.Pages }}
    {{- $rel := .RelPermalink }}
    {{- $skip := false }}
    {{- if not .Permalink }}{{ $skip = true }}{{ end }}
    {{- if in $skipExact $rel }}{{ $skip = true }}{{ end }}
    {{- range $skipPrefixes }}
      {{- if hasPrefix $rel . }}{{ $skip = true }}{{ end }}
    {{- end }}
    {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- $last := .Lastmod }}
    {{- if and $last (not $last.IsZero) }}
    <lastmod>{{ $last.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>{{ if .IsPage }}0.8{{ else }}0.5{{ end }}</priority>
  </url>
    {{- end }}
  {{- end }}
</urlset>