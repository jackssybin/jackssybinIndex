{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Site.BaseURL }}</link>
    <description>{{ .Site.Params.description }}</description>
    {{- $legacyArticles := where .Site.RegularPages "Params.contentType" "article" }}
    {{- $currentArticles := where .Site.RegularPages "Type" "articles" }}
    {{- $articles := sort (union $legacyArticles $currentArticles) "Date" "desc" }}
    {{- $articles = where $articles "Title" "ne" "" }}
    {{ range first 20 $articles }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
