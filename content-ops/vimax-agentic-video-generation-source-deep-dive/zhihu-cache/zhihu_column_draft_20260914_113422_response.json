247\u4f1a\u4ea7\u751f\u76f8\u5f53\u6570\u91cf\u7684\u56fe\u50cf\u4e0e\u89c6\u9891\u751f\u6210\u8d39\u7528\uff0c\u89c6\u9891\u751f\u6210\u5c24\u5176\u6602\u8d35\u3002README \u4e2d\u300c\u7535\u5f71\u7ea7\u300d\u300c\u5c0f\u65f6\u7ea7\u300d\u66f4\u591a\u662f\u613f\u666f\u63aa\u8f9e\uff0c\u5b9e\u9645\u8d28\u91cf\u5f3a\u4f9d\u8d56\u6240\u9009\u5916\u90e8\u6a21\u578b\uff0c\u5206\u949f\u7ea7\u957f\u7247\u4ecd\u9700\u8981\u9010\u955c\u5ba1\u6838\u3002\u4ed3\u5e93\u81ea\u5e26\u7684 benchmark \u591a\u4e3a\u5355\u573a\u666f\u3001\u53cc\u4eba\u6216\u4e09\u4eba\u7684\u955c\u5934\u7ea7\u6837\u4f8b\uff0c\u8fd9\u66f4\u80fd\u53cd\u6620\u5b83\u5f53\u524d\u7a33\u5b9a\u8986\u76d6\u7684\u7c92\u5ea6\u3002<\/p>\n<h2>\u516d\u3001\u9002\u7528\u5224\u65ad<\/h2>\n<p>\u9002\u5408\u73b0\u5728\u4f7f\u7528\u6216\u7814\u7a76\u7684\uff0c\u662f\u60f3\u7cfb\u7edf\u5b66\u4e60\u591a Agent \u5982\u4f55\u7f16\u6392\u957f\u6d41\u7a0b\u751f\u6210\u4efb\u52a1\u7684\u5de5\u7a0b\u5e08\u2014\u2014\u5355\u4e00\u804c\u8d23 Agent\u3001\u5171\u4eab\u6e32\u67d3\u540e\u7aef\u3001\u68c0\u7d22\u589e\u5f3a\u3001\u89c6\u89c9\u54c1\u63a7\u3001\u5206\u7ea7\u5e76\u53d1\u548c\u9632\u6302\u6b7b\u6d4b\u8bd5\u6784\u6210\u4e86\u4e00\u4e2a\u76f8\u5f53\u5b8c\u6574\u7684\u53c2\u8003\u6837\u672c\uff1b\u662f\u6709\u5916\u90e8 API \u9884\u7b97\u3001\u9700\u8981\u628a\u5267\u672c\u6216\u6982\u5ff5\u6279\u91cf\u5236\u4f5c\u4e3a\u89d2\u8272\u4e00\u81f4\u7684\u5206\u955c\u89c6\u9891\u3001\u5e76\u613f\u610f\u5728 Web UI \u4e2d\u9010\u955c\u628a\u5173\u7684\u56e2\u961f\uff1b\u4e5f\u662f\u5e0c\u671b\u81ea\u6258\u7ba1\u7f16\u6392\u5c42\u3001\u5728\u591a\u5bb6\u4f9b\u5e94\u5546\u4e4b\u95f4\u7075\u6d3b\u5207\u6362\u7684\u7528\u6237\uff0cMIT \u534f\u8bae\u5bf9\u5546\u7528\u53cb\u597d\u3002<\/p>\n<p>\u5efa\u8bae\u89c2\u671b\u7684\uff0c\u662f\u671f\u5f85\u672c\u5730\u96f6\u6210\u672c\u3001\u4e00\u53e5\u8bdd\u76f4\u63a5\u5f97\u5230\u6210\u7247\u7684\u4eba\uff1b\u662f\u4e3b\u8981\u8bc9\u6c42\u4e3a\u6574\u672c\u5c0f\u8bf4\u7a33\u5b9a\u6539\u7f16\u7