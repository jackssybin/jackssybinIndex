1\u578b\u6210\u4e3a\u505a\u77ed\u7247\u7684\u9ed8\u8ba4\u9009\u9879\uff0c\u4e00\u4e2a\u5f00\u6e90\u4ed3\u5e93\u9009\u62e9\u4e86\u5b8c\u5168\u76f8\u53cd\u7684\u6280\u672f\u8def\u7ebf\u3002lemomo-ai/lemo-opuscar \u5728 GitHub \u4e0a\u51e0\u5468\u5185\u6da8\u5230 2.1k Star\uff0c\u5b83\u7684\u505a\u6cd5\u662f\uff1a\u4e0d\u7528\u4efb\u4f55\u89c6\u9891\u6a21\u578b\uff0c\u8ba9\u7f16\u7a0b Agent\uff08Claude Opus 5.5\uff09\u5199 Canvas/Three.js \u4ee3\u7801\uff0c\u9010\u5e27\u6e32\u67d3\u51fa\u6574\u90e8\u52a8\u753b\u3002\u6211\u514b\u9686\u4e86\u4ed3\u5e93\uff0c\u901a\u8bfb\u4e86\u5b83\u7684\u5bfc\u6f14\u624b\u518c\u3001\u6280\u672f\u6587\u6863\u548c\u6e32\u67d3\u5de5\u5177\u94fe\u6e90\u7801\uff0c\u8fd9\u7bc7\u662f\u57fa\u4e8e\u6e90\u7801\u7684\u62c6\u89e3\u4e0e\u5224\u65ad\u3002<\/p>\n<h2>\u4e00\u3001\u6838\u5fc3\u7ea6\u5b9a\uff1a\u753b\u9762\u662f\u65f6\u95f4\u7684\u786e\u5b9a\u6027\u51fd\u6570<\/h2>\n<p>\u4ed3\u5e93\u7684\u6280\u672f\u57fa\u5ea7\u53ef\u4ee5\u7528\u4e00\u4e2a\u9875\u9762\u5951\u7ea6\u6982\u62ec\uff08\u89c1\u4ed3\u5e93 TECHNIQUE.md \u00a72\uff09\u3002\u6bcf\u90e8\u7247\u5b50\u662f\u4e00\u4e2a index.html\uff0c\u66b4\u9732\u56db\u4e2a\u5168\u5c40\u91cf\uff1aDUR\uff08\u7247\u957f\uff09\u3001render(t)\uff08\u7ed8\u5236\u7b2c t \u79d2\u7684\u5e27\uff09\u3001READY\uff08\u7d20\u6750\u52a0\u8f7d\u5b8c\u6210\u4fe1\u53f7\uff09\u3001TEXTS(t)\uff08\u753b\u9762\u6587\u5b57\u53ca\u5305\u56f4\u76d2\uff0c\u53ef\u9009\uff09\u3002<\/p><pre lang=\"javascript\">window.DUR = 54.2                 // \u7247\u957f\uff08\u79d2\uff09\nwindow.render = (t) =&gt; { ... };    // \u7ed8\u5236\u7b2c t \u79d2\u90a3\u4e00\u5e27\uff0c\u5fc5\u987b\u786e\u5b9a\u6027\nwindow.READY = true;               // \u5b57\u4f53\u3001\u56fe\u7247\u52a0\u8f7d\u5b8c\u624d\u7f6e\u4f4d\nwindow.TEXTS = (t) =&gt; [{id, text, x0, y0, x1, y1}];<\/pre>\n<p>\u5176\u4e2d\u6700\u5173\u952e\u7684\u8bbe\u8ba1\u7ea6\u675f\u662f render(t) \u5fc5\u987b\u4e3a\u7eaf\u51fd\u6570\uff1a\u7981\u6b62 Date.now()\uff0c\u7981\u6b62\u672a\u64ad\u79cd\u7684 Math.random()\uff08core/lib.js \u63d0\u4f9b mulberry\u3001hash \u4e24\u4e2a\u786e\u5b9a\u6027\u968f\u673a\u6e90\uff09\uff0c\u7981\u6b62\u8de8\u5e27\u643a\u5e26\u72b6\u6001\u3002\u8fd9\u610f\u5473\u7740\u4efb\u610f\u4e00\u5e27\u90fd\u53ef\u4ee5\u72ec\u7acb\u6e32\u67d3\u3001\u4efb\u610f\u987a\u5e8f\u6e32\u67d3\u3001\u4ea4\u7ed9\u4efb\u610f worker \u6e32\u67d3\uff0c\u8f93\u51fa\u4e25\u683c\u4e00\u81f4\u3002<\/p>\n<img alt=\"Lemo-Opuscar \u7684\u751f\u4ea7\u7ba1\u7ebf\" src=\"https://pic1.zhimg.com/v2-847000053c5998b9b9b0d92478a50da1_720w.png?source=d16d100b\" class=\"content_image\">\n<p>\u6e32\u67d3\u7aef core/render/video.mjs \u57fa\u4e8e playwright-core\uff0c\u5f00\u6700\u591a 6 \u4e2a\u65e0\u5934\u6d4f\u89c8\u5668 worker\uff0c\u6bcf\u5e27\u622a JPEG\uff08\u4ed3\u5e93\u6ce8\u91ca\u89e3\u91ca\u4e86\u4e24\u4e2a\u6027\u80fd\u53d6\u820d\uff1a\u7528 JPEG \u800c\u975e PNG\uff1b\u80f6\u7247\u9897\u7c92\u4e0d\u5728\u9875\u9762\u91cc\u7ed8\u5236\u2014\u2014\u9010\u5e27\u566a\u58f0\u4f1a\u8ba9\u753b\u9762\u4e0d\u53ef\u538b\u7f29\uff0c\u9897\u7c92\u7edf\u4e00\u4ea4\u7ed9 ffmpeg \u540e\u671f\u6dfb\u52a0\uff09\u3002\u9ed8\u8ba4\u8f93\u51fa 1920\u00d71080\u300124fps\u3002\u53e6\u6709\u4e00\u6761\u52a8\u753b\u89c4\u5219\u503c\u5f97\u6ce8\u610f\uff1a\u505c\u683c\u3001\u50cf\u7d20\u3001\u8d5b\u7490\u7490\u98ce\u683c\u53ef\u4ee5 on twos\uff08\u6bcf\u79d2 12 \u5f20\uff09\uff0c\u4f46\u6444\u5f71\u673a\u8fd0\u52a8\u548c\u5149\u7167\u5fc5\u987b\u9010\u5e27\u5e73\u6ed1\uff0c\u56e0\u4e3a\u6b65\u8fdb\u7684\u955c\u5934\u4f1a\u88ab\u611f\u77e5\u4e3a\u5361\u987f\u3002<\/p>\n<p>\u4f9d\u8d56\u63a7\u5236\u5f97\u5f88\u8f7b\uff1anpm \u4fa7\u53ea\u6709 playwright-core \u548c three \u4e24\u4e2a\u5305\uff0cPython \u4fa7\u6309 core / voice / music \u4e09\u5c42\u53ef\u9009\u5b89\u88c5\uff0c\u7cfb\u7edf\u8981\u6c42 Node 20+\u3001ffmpeg\u3001Python 3.11\u20133.13\u3002<\/p><pre lang=\"bash\"># \u4f5c\u4e3a Claude Code \u63d2\u4ef6\u5b89\u88c5\uff08\u63a8\u8350\uff09\nclaude plugin marketplace add lemomo-ai/lemo-opuscar\nclaude plugin install lemo-opuscar@lemolab\n# \u5206\u5c42\u4f9d\u8d56\uff1acore / voice / music \u6309\u9700\u88c5\nsh plugin/skills/lemo-opuscar/scripts/setup.sh deps<\/pre>\n<h2>\u4e8c\u3001\u5355\u4e00\u65f6\u95f4\u7ebf\u9a71\u52a8\u753b\u9762\u3001\u97f3\u4e50\u4e0e\u5b57\u5e55<\/h2>\n<p>\u5de5\u7a0b\u4e0a\u7b2c\u4e8c\u4e2a\u503c\u5f97\u8bf4\u7684\u8bbe\u8ba1\uff0c\u662f\u5168\u7247\u53ea\u7ef4\u62a4\u4e00\u4efd timeline.js\uff1a\u6bb5\u843d\u3001\u901f\u5ea6\uff08BPM\uff09\u3001\u8282\u62cd\u6570\u3001\u5173\u952e\u5207\u70b9\u90fd\u5728\u8fd9\u4e00\u4e2a\u6587\u4ef6\u91cc\uff0c\u5bfc\u51fa JSON \u540e\u4f9b\u914d\u4e50\u3001\u6df7\u97f3\u3001\u5b57\u5e55\u548c\u68c0\u67e5\u811a\u672c\u8bfb\u53d6\u540c\u4e00\u4efd\u6570\u636e\u3002\u591a\u4e2a\u6837\u7247\u81ea\u5e26 cuecheck.py\uff0c\u5c06\u89c6\u89c9\u5207\u70b9\u4e0e\u97f3\u4e50\u62cd\u70b9\u9010\u4e00\u6bd4\u5bf9\uff0c\u76ee\u6807\u4e3a 0ms \u504f\u5dee\u3002<\/p>\n<p>\u58f0\u97f3\u94fe\u8def\u7684\u5b8c\u6574\u5ea6\u8d85\u51fa\u4e00\u822c\u9884\u671f\uff1a<\/p>\n<p>\u82f1\u6587\u914d\u97f3\u9ed8\u8ba4\u7528 Kokoro\uff08kokoro-onnx\uff0c\u5b8c\u5168\u79bb\u7ebf\uff09\uff0c\u4e2d\u6587\u7528 edge-tts \u7684\u5fae\u8f6f\u795e\u7ecf\u97f3\u8272\uff08tts_zh.py\uff0c\u9700\u8981\u8054\u7f51\uff09\uff1b\u751f\u6210\u540e\u7531 asr_check.py \u8c03 faster-whisper \u53cd\u5411\u8f6c\u5199\uff0c\u4e0e\u53f0\u8bcd\u9010\u5b57\u6bd4\u5bf9\uff0c\u4e2d\u6587\u6309\u5b57\u6838\u5bf9\uff0c\u4e0d\u901a\u8fc7\u5219\u91cd\u751f\u6210\u3002\u914d\u4e50\u7531 core/audio/sampler.py \u9a71\u52a8\u514d\u8d39\u91c7\u6837\u5e93\uff08freepats\u3001karoryfer\u3001salamander \u4e09\u89d2\u94a2\u7434\u3001VCSL\u3001VSCO2 CE\uff09\u5408\u6210\u539f\u521b\u97f3\u4e50\uff0cpluck.py \u7528 numba \u505a\u62e8\u5f26\u5408\u6210\u3002\u6700\u7ec8 mux.sh \u8dd1\u4e24\u904d ffmpeg loudnorm\uff0c\u5f52\u4e00\u5316\u5230 \u221214 LUFS\u3001\u771f\u5cf0\u503c \u22121.2dB\uff1b\u914d\u97f3\u5148\u538b\u7f29\u518d\u6309 RMS \u538b\u97f3\u4e50\u7ea6 10dB\u3002\u97f3\u9891\u9759\u97f3\u3001\u635f\u574f\u6216\u622a\u65ad\u4f1a\u88ab\u76f4\u63a5\u62d2\u6536\u3002<\/p>\n<p>\u5b83\u8fd8\u6709\u4e00\u4e2a readcheck \u673a\u5236\uff1a\u6e32\u67d3\u5668\u6bcf 0.04 \u79d2\u67e5\u8be2 TEXTS(t)\uff0c\u5f3a\u5236\u753b\u9762\u6587\u5b57\u5b8c\u6574\u505c\u7559\u300c\u4e2d\u6587\u5b57\u6570\u00f74.5 + \u62c9\u4e01\u5b57\u7b26\u6570\u00f715 + 1.5 \u79d2\u300d\u4ee5\u4e0a\u3002\u8fd9\u662f\u628a\u300c\u89c2\u4f17\u6765\u4e0d\u53ca\u8bfb\u5b8c\u5b57\u5e55\u300d\u4ece\u4e3b\u89c2\u5ba1\u7f8e\u95ee\u9898\u53d8\u6210\u4e86\u53ef\u6267\u884c\u7684\u786c\u7ea6\u675f\u3002<\/p>\n<h2>\u4e09\u300143 \u4e2a\u98ce\u683c\u76ee\u5f55\uff1a\u98ce\u683c\u6cd5\u5219\u4e0e\u6837\u7247\u6e90\u7801\u5206\u79bb<\/h2>\n<p>\u4ed3\u5e93\u4e3b\u4f53 styles/ \u4e0b\u662f 43 \u4e2a\u98ce\u683c\uff0c\u5206\u4e5d\u7c7b\uff1a\u624b\u7ed8\u7ed8\u753b\u3001\u4e1c\u65b9\u4f20\u7edf\u3001\u5370\u5237\u7248\u753b\u3001\u56fe\u5f62\u6392\u7248\u3001\u4fe1\u606f\u53d1\u5e03\u3001\u5361\u901a\u52a8\u753b\u3001\u6e38\u620f\u3001\u7535\u5f71\u65f6\u4ee3\u3001\u6750\u8d28 3D\u3002\u6bcf\u4e2a\u76ee\u5f55\u5305\u542b STYLE.md\uff08\u98ce\u683c\u4e0d\u53d8\u91cf\uff1a\u914d\u8272\u3001\u5b57\u4f53\u3001\u8fd0\u955c\u8bed\u6cd5\u3001\u58f0\u97f3\u8c03\u8272\u677f\u3001\u8be5\u5a92\u4ecb\u7684\u539f\u751f\u52a8\u4f5c\u4e0e\u9677\u9631\uff09\u548c DEMO.md + demo/\uff08\u4f5c\u8005\u7528\u8be5\u98ce\u683c\u62cd\u6444\u7684\u5b8c\u6574\u6837\u7247\u6e90\u7801\uff09\u3002<\/p>\n<img alt=\"43 \u79cd\u98ce\u683c\u4e2d\u7684 12 \u683c\u5207\u7247\uff0c\u5747\u4e3a\u5b98\u65b9\u6837\u7247\u7684\u771f\u5b9e\u6e32\u67d3\u5e27\" src=\"https://picx.zhimg.com/v2-babab36c523bc12b46d60e8a78a8f334_720w.png?source=d16d100b\" class=\"content_image\">\n<p>\u5de5\u4f5c\u6d41\u89c4\u5219\uff08AGENTS.md\uff09\u6709\u660e\u786e\u7684\u7acb\u573a\uff1a\u63a5\u5230\u7528\u6237\u9898\u6750\u540e\uff0c\u5fc5\u987b\u5148\u5199\u81ea\u5df1\u7684 TREATMENT.md\u2014\u2014\u4e09\u79cd\u53d9\u4e8b\u7ed3\u6784\u5019\u9009\u3001\u9009\u4e00\u5e76\u8bf4\u660e\u7406\u7531\u3001\u53ea\u5411 benchmark \u5b66\u4e60\u6784\u56fe\u4e0e\u8282\u594f\u8bed\u6cd5\u800c\u4e0d\u501f\u5185\u5bb9\u2014\u2014\u5199\u5b8c\u4e4b\u540e\u624d\u5141\u8bb8\u6253\u5f00\u8be5\u98ce\u683c\u7684 DEMO.md\uff1bdemo \u53ea\u7528\u4e8e\u5b66\u4e60\u6280\u6cd5\uff08\u7b14\u5237\u5f15\u64ce\u3001\u7ed1\u5b9a\u3001shader\uff09\uff0c\u7981\u6b62\u590d\u7528\u5176\u6545\u4e8b\u3001\u5206\u955c\u548c\u9053\u5177\u3002\u7528\u6237\u4f5c\u54c1\u4ea7\u51fa\u5728 styles/ \u76ee\u5f55\u4e4b\u5916\uff0c\u4e0d\u52a0\u4f5c\u8005\u7f72\u540d\u6216\u6c34\u5370\u3002DIRECTOR.md \u5219\u89c4\u5b9a\u4e86\u524d 3 \u79d2\u5fc5\u987b\u6709\u94a9\u5b50\u3001\u6bcf\u7247\u8981\u6709\u4e00\u4e2a\u53ea\u6709\u8be5\u5a92\u4ecb\u80fd\u5b8c\u6210\u7684\u300c\u539f\u751f\u52a8\u4f5c\u300d\u5e76\u653e\u5728\u60c5\u7eea\u9ad8\u70b9\u7b49\u521b\u4f5c\u7ea6\u675f\u3002<\/p>\n<img alt=\"\u4e2d\u56fd\u6c34\u58a8\u98ce\u683c\u6837\u7247\u5e27\" src=\"https://picx.zhimg.com/v2-6300c4a2e9ce8775dc722a79c2f6500f_720w.jpg?source=d16d100b\" class=\"content_image\">\n<p>\u5206\u53d1\u5f62\u6001\u4e5f\u503c\u5f97\u505a Agent Skill \u7684\u4eba\u53c2\u8003\uff1a\u5b83\u540c\u65f6\u662f git \u4ed3\u5e93\u548c Claude Code plugin marketplace\uff08\u4e24\u884c\u547d\u4ee4\u5b89\u88c5\uff09\u3002setup.sh \u9ed8\u8ba4\u7528 sparse clone \u53ea\u62c9\u6307\u5357\u3001core \u5de5\u5177\u548c STYLE.md\uff0c\u6392\u9664 demo \u6e90\u7801\u4e0e\u5927\u56fe\uff1b\u4f9d\u8d56\u5b89\u88c5\u4ee5 package.json \u548c requirements \u7684\u6821\u9a8c\u548c\u505a\u6807\u8bb0\uff0c\u6587\u4ef6\u672a\u53d8\u5c31\u4e0d\u91cd\u88c5\u3002\u4f5c\u8005\u8fd8\u63d0\u4ea4\u4e86 OPUSCAR 98\uff1a6 \u5206 31 \u79d2\u300198 \u90e8\u5965\u65af\u5361\u6700\u4f73\u5f71\u7247\u753b\u98ce\uff082D 77 \u90e8\u30012.5D 4 \u90e8\u30013D 17 \u90e8\uff09\uff0c\u6bcf\u90e8\u9644\u53ef\u590d\u7528\u7684\u98ce\u683c\u63d0\u793a\u8bcd\u4e0e\u955